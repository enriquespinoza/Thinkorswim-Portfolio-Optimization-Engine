# Schwab Trader API - Individual
# Copy this file to .env and replace placeholders locally.
# Never commit real credentials or OAuth tokens.

# Legacy/default Schwab profile retained for backward compatibility.
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182
SCHWAB_TOKEN_PATH=tokens/schwab_token.json

# Schwab Accounts and Trading Production app.
# Used only through the repository's read-only account wrapper.
SCHWAB_ACCOUNTS_APP_KEY=
SCHWAB_ACCOUNTS_APP_SECRET=
SCHWAB_ACCOUNTS_CALLBACK_URL=https://127.0.0.1:8182
SCHWAB_ACCOUNTS_TOKEN_PATH=tokens/schwab_accounts_token.json

# Schwab Market Data Production app.
SCHWAB_MARKET_DATA_APP_KEY=
SCHWAB_MARKET_DATA_APP_SECRET=
SCHWAB_MARKET_DATA_CALLBACK_URL=https://127.0.0.1:8182
SCHWAB_MARKET_DATA_TOKEN_PATH=tokens/schwab_market_data_token.json

# Optional research-data credentials
FRED_API_KEY=
